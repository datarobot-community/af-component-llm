# Maintainer E2E prerequisites for af-component-llm (component repo only).
# Copy to .env and fill in values before running: task test-e2e:<config>
#
# Recipe / consumer projects maintain their own aggregate .env at project root.

# --- Required for all E2E runs ---
DATAROBOT_ENDPOINT=https://app.datarobot.com/api/v2
DATAROBOT_API_TOKEN=

# --- Optional shared infra overrides ---
# DATAROBOT_DEFAULT_USE_CASE=
# DATAROBOT_DEFAULT_PREDICTION_ENVIRONMENT=

# --- gateway_direct / blueprint_with_llm_gateway (LLM Gateway catalog model) ---
LLM_DEFAULT_MODEL=datarobot/azure/gpt-5-mini-2025-08-07

# --- deployed_llm (pre-provisioned deployment; task masks clear gateway/NIM vars) ---
LLM_DEPLOYMENT_ID=

# --- registered_model ---
TEXTGEN_REGISTERED_MODEL_ID=
# DATAROBOT_TIMEOUT_MINUTES=30

# --- blueprint_with_external_llm (your own provider credentials; gateway not used) ---
# LLM_DEFAULT_LLM_ID is required here: an external endpoint has no LLM Gateway catalog entry,
# so the Playground LLM cannot be derived from LLM_DEFAULT_MODEL.
LLM_DEFAULT_LLM_ID=azure-openai-gpt-5-mini
# LLM_DEFAULT_LLM_NAME=Azure OpenAI GPT-5 Mini
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_API_DEPLOYMENT_ID=
OPENAI_API_VERSION=

# --- Optional manual NIM E2E only (not run in CI): RUN_NIM_E2E=1 task test-e2e:nim-deployed-llm ---
# RUN_NIM_E2E=1
# NIM_DEPLOYMENT_ID=
# LLM_DEFAULT_MODEL=meta-llama/Llama-3.1-8B  # overrides the gateway default above for a NIM run
